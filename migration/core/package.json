{
  "name": "@migration/core",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','build-test']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"build-test/test/*.js\"",
    "typecheck": "npm run build && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.9.3"
  }
}
