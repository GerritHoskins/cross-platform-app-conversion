+describe('ScheduleScreen RN07 regressions', () => {
+  afterEach(() => jest.restoreAllMocks());
+
+  function sectionList(): Fiber {
+    let fiber: Fiber | null = screen.getAllByTestId(/^session-/)[0].unstable_fiber;
+    while (fiber && fiber.type !== SectionList && fiber.elementType !== SectionList) fiber = fiber.return;
+    expect(fiber).not.toBeNull();
+    return fiber!;
+  }
+
+  test('F-1 keeps handled row and favorite taps available with the keyboard open', async () => {
+    const view = await render(<ConferenceProvider><ScheduleScreen /></ConferenceProvider>);
+    await screen.findByTestId('session-1');
+    expect(sectionList().memoizedProps.keyboardShouldPersistTaps).toBe('handled');
+    await view.unmount();
+  });
+
+  test('F-2 scrolls to top for tracks, search and mode, not favorites, without remounting a nonempty list', async () => {
+    let conference!: ReturnType<typeof useConference>;
+    function Probe() {
+      conference = useConference();
+      return null;
+    }
+    const scroll = jest.spyOn(SectionList.prototype, 'scrollToLocation').mockImplementation(() => {});
+    const view = await render(<ConferenceProvider><ScheduleScreen /><Probe /></ConferenceProvider>);
+    await screen.findByTestId('session-1');
+    const instance = sectionList().stateNode;
+    scroll.mockClear();
+    await act(async () => { conference.dispatch({ type: 'favoriteAdded', sessionId: 4 }); });
+    expect(scroll).not.toHaveBeenCalled();
+
+    await act(async () => { conference.dispatch({ type: 'setSelectedTracks', selectedTracks: ['Ionic'] }); });
+    expect(scroll).toHaveBeenCalledTimes(1);
+    expect(scroll).toHaveBeenLastCalledWith({ sectionIndex: 0, itemIndex: 0, animated: false });
+    expect(sectionList().stateNode).toBe(instance);
+    scroll.mockClear();
+    await fireEvent.changeText(screen.getByLabelText('Search sessions'), 'University');
+    expect(scroll).toHaveBeenCalledTimes(1);
+    expect(scroll).toHaveBeenLastCalledWith({ sectionIndex: 0, itemIndex: 0, animated: false });
+    expect(sectionList().stateNode).toBe(instance);
+    scroll.mockClear();
+    await fireEvent.press(screen.getByTestId('mode-favorites'));
+    expect(scroll).toHaveBeenCalledTimes(1);
+    expect(scroll).toHaveBeenLastCalledWith({ sectionIndex: 0, itemIndex: 0, animated: false });
+    expect(sectionList().stateNode).toBe(instance);
+    scroll.mockClear();
+    await act(async () => { conference.dispatch({ type: 'favoriteAdded', sessionId: 2 }); });
+    await act(async () => { conference.dispatch({ type: 'favoriteRemoved', sessionId: 2 }); });
+    expect(scroll).not.toHaveBeenCalled();
+
+    // Empty results unmount the list: do not scroll to a nonexistent section.
+    await act(async () => { conference.dispatch({ type: 'setSelectedTracks', selectedTracks: [] }); });
+    expect(screen.getByText('No sessions match your search or filters.')).toBeTruthy();
+    expect(scroll).not.toHaveBeenCalled();
+    await act(async () => { conference.dispatch({ type: 'setSelectedTracks', selectedTracks: ['Ionic'] }); });
+    expect(scroll).toHaveBeenCalledTimes(1);
+    await view.unmount();
+  });
