import { useCallback, useEffect, useRef } from 'react';
import Swipeable, { type SwipeableMethods } from 'react-native-gesture-handler/ReanimatedSwipeable';

import {
  ActivityIndicator,
  Alert,
  Pressable,
  SectionList,
  StyleSheet,
  Text,
  TextInput,
  useColorScheme,
  View,
} from 'react-native';

import type { ScheduleMode, Session, SessionGroup } from '@migration/core';

import { useConference } from '../state/conference-state';

interface Palette {
  background: string;
  surface: string;
  text: string;
  subtle: string;
  border: string;
  accent: string;
  accentSoft: string;
}

const PALETTES: Record<'light' | 'dark', Palette> = {
  light: {
    background: '#f5f5f7',
    surface: '#ffffff',
    text: '#111114',
    subtle: '#5c5c66',
    border: '#d9d9de',
    accent: '#4e6e5e',
    accentSoft: '#e4eee9',
  },
  dark: {
    background: '#101014',
    surface: '#1c1c22',
    text: '#f2f2f5',
    subtle: '#a7a7b2',
    border: '#3a3a44',
    accent: '#9fd3b4',
    accentSoft: '#24352c',
  },
};

function ModeButton({
  label,
  mode,
  active,
  disabled,
  palette,
  onPress,
}: {
  label: string;
  mode: ScheduleMode;
  active: boolean;
  disabled: boolean;
  palette: Palette;
  onPress: (mode: ScheduleMode) => void;
}) {
  return (
    <Pressable
      accessibilityRole="button"
      accessibilityLabel={label}
      accessibilityState={{ selected: active, disabled }}
      disabled={disabled}
      testID={`mode-${mode}`}
      onPress={() => onPress(mode)}
      style={({ pressed }) => [
        styles.modeButton,
        {
          borderColor: active ? palette.accent : palette.border,
          backgroundColor: active ? palette.accentSoft : palette.surface,
          opacity: disabled ? 0.5 : pressed ? 0.85 : 1,
        },
      ]}
    >
      <Text style={[styles.modeButtonLabel, { color: active ? palette.accent : palette.text }]}>
        {label}
      </Text>
    </Pressable>
  );
}

function Row({ session, palette, onRowOpen, onRowClose }: {
  session: Session;
  palette: Palette;
  onRowOpen: (methods: SwipeableMethods) => void;
  onRowClose: (methods: SwipeableMethods) => void;
}) {
  const swipeable = useRef<SwipeableMethods | null>(null);
  const open = useRef(false);
  useEffect(() => () => {
    if (swipeable.current) onRowClose(swipeable.current);
  }, [onRowClose]);
  const { state, dispatch } = useConference();
  const favoritesMode = state.selection?.mode === 'favorites';
  const favorite = state.selection?.favoriteIds.includes(session.id) ?? false;

  const handleFavorite = (onSettled?: () => void) => {
    if (favoritesMode || favorite) {
      Alert.alert(
        favoritesMode ? 'Remove Favorite' : 'Favorite already added',
        'Would you like to remove this session from your favorites?',
        [
          { text: 'Cancel', style: 'cancel', onPress: onSettled },
          {
            text: 'Remove',
            style: 'destructive',
            onPress: () => {
              dispatch({ type: 'favoriteRemoved', sessionId: session.id });
              onSettled?.();
            },
          },
        ],
      );
    } else {
      dispatch({ type: 'favoriteAdded', sessionId: session.id });
      Alert.alert('Favorite Added', undefined, [{ text: 'OK', onPress: onSettled }]);
    }
  };

  return (
    <Swipeable
      ref={swipeable}
      friction={2}
      rightThreshold={40}
      overshootRight={false}
      onSwipeableWillOpen={() => {
        open.current = true;
        if (swipeable.current) onRowOpen(swipeable.current);
      }}
      onSwipeableClose={() => {
        open.current = false;
        if (swipeable.current) onRowClose(swipeable.current);
      }}
      renderRightActions={(_progress, _translation, methods) => (
        <View
          testID={`swipe-action-${session.id}`}
          accessibilityElementsHidden
          importantForAccessibility="no-hide-descendants"
          style={[styles.swipeAction, { backgroundColor: palette.accentSoft }]}
        >
          <Pressable
            onPress={() => handleFavorite(() => methods.close())}
            style={styles.swipeActionButton}
          >
            <Text style={{ color: palette.accent, fontWeight: '600' }}>{favoritesMode ? 'Remove' : 'Favorite'}</Text>
          </Pressable>
        </View>
      )}
    >
      <View testID={`session-${session.id}`} style={[styles.row, { backgroundColor: palette.surface, borderColor: palette.border }]}>
        <Pressable
          accessibilityRole="link"
          accessibilityLabel={session.name}
          onPress={() => {
            if (open.current) {
              swipeable.current?.close();
              return;
            }
            router.push({ pathname: '/session/[sessionId]', params: { sessionId: String(session.id) } });
          }}
        >
          <Text
            accessibilityRole="header"
            style={[styles.sessionName, { color: palette.text }]}
          >
            {session.name}
          </Text>
          <Text style={[styles.meta, { color: palette.subtle }]}>
            {session.timeStart}â{session.timeEnd} Â· {session.location}
          </Text>
          <Text style={[styles.meta, { color: palette.subtle }]}>{session.tracks.join(', ')}</Text>
        </Pressable>
        <Pressable
          accessibilityRole="button"
          accessibilityLabel={`${favoritesMode ? 'Remove' : 'Favorite'} ${session.name}`}
          onPress={() => handleFavorite()}
          style={[styles.retryButton, { borderColor: palette.accent, alignSelf: 'flex-start' }]}
        >
          <Text style={{ color: palette.accent }}>{favoritesMode ? 'Remove' : 'Favorite'}</Text>
        </Pressable>
      </View>
    </Swipeable>
  );
}

export default function ScheduleScreen() {
  const { state, dispatch, retry, groups } = useConference();
  const scheme = useColorScheme() ?? 'light';
  const palette = PALETTES[scheme];

  const ready = state.status === 'ready';
  const selection = state.selection;
  const searchText = selection?.searchText ?? '';
  const activeMode: ScheduleMode = selection?.mode ?? 'all';
  const favoritesCount = selection?.favoriteIds.length ?? 0;
  const openRow = useRef<SwipeableMethods | null>(null);
  const onRowOpen = useCallback((methods: SwipeableMethods) => {
    if (openRow.current && openRow.current !== methods) openRow.current.close();
    openRow.current = methods;
  }, []);
  const onRowClose = useCallback((methods: SwipeableMethods) => {
    if (openRow.current === methods) openRow.current = null;
  }, []);

  useEffect(() => {
    openRow.current?.close();
    openRow.current = null;
  }, [searchText, activeMode, selection?.selectedTracks]);

  const handleSearch = (nextSearchText: string) => {
    dispatch({ type: 'setSearchText', searchText: nextSearchText });
  };

  const handleMode = (mode: ScheduleMode) => {
    dispatch({ type: 'setMode', mode });
  };

  const sections: Array<{ key: string; title: string; data: Session[] }> = groups.map(
    (group: SessionGroup) => ({ key: group.groupTime, title: group.groupTime, data: group.sessions }),
  );

  const emptyMessage =
    ready && groups.length === 0
      ? activeMode === 'favorites' && favoritesCount === 0
        ? 'No favorite sessions.'
        : 'No sessions match your search or filters.'
      : null;

  return (
    <View style={[styles.screen, { backgroundColor: palette.background }]}>
      <Text accessibilityRole="header" style={[styles.heading, { color: palette.text }]}>
        Conference
      </Text>

      <View style={[styles.controls, { borderColor: palette.border }]}>
        <TextInput
          accessibilityRole="search"
          accessibilityLabel="Search sessions"
          accessibilityState={{ disabled: !ready }}
          editable={ready}
          value={searchText}
          onChangeText={handleSearch}
          placeholder="Search sessions"
          placeholderTextColor={palette.subtle}
          returnKeyType="search"
          style={[
            styles.input,
            { color: palette.text, borderColor: palette.border, backgroundColor: palette.surface },
          ]}
        />
        <View style={styles.modeRow}>
          <ModeButton
            label="All sessions"
            mode="all"
            active={activeMode === 'all'}
            disabled={!ready}
            palette={palette}
            onPress={handleMode}
          />
          <ModeButton
            label="Favorite sessions"
            mode="favorites"
            active={activeMode === 'favorites'}
            disabled={!ready}
            palette={palette}
            onPress={handleMode}
          />
        </View>
        <Pressable
          accessibilityRole="button"
          accessibilityLabel="Filter sessions"
          accessibilityState={{ disabled: !ready }}
          disabled={!ready}
          onPress={() => router.push('/filter')}
          style={({ pressed }) => [
            styles.retryButton,
            { borderColor: palette.accent, backgroundColor: palette.surface, opacity: !ready ? 0.5 : pressed ? 0.85 : 1 },
          ]}
        >
          <Text style={{ color: palette.accent, fontWeight: '600' }}>Filter</Text>
        </Pressable>
      </View>

      {state.status === 'idle' || state.status === 'loading' ? (
        <View accessibilityRole="progressbar" accessibilityLabel="Loading sessions" style={styles.statusBlock}>
          <ActivityIndicator color={palette.accent} />
          <Text style={{ color: palette.text }}>Loading sessionsâ¦</Text>
        </View>
      ) : null}

      {state.status === 'error' ? (
        <View accessibilityRole="alert" style={styles.statusBlock}>
          <Text style={{ color: palette.text, fontWeight: '600' }}>Unable to load sessions.</Text>
          {state.error ? <Text style={{ color: palette.subtle }}>{state.error}</Text> : null}
          <Pressable
            accessibilityRole="button"
            accessibilityLabel="Retry"
            onPress={retry}
            style={[
              styles.retryButton,
              { borderColor: palette.accent, backgroundColor: palette.accentSoft },
            ]}
          >
            <Text style={{ color: palette.accent, fontWeight: '600' }}>Retry</Text>
          </Pressable>
        </View>
      ) : null}

      {ready ? (
        emptyMessage !== null ? (
          <Text style={[styles.emptyMessage, { color: palette.subtle }]}>{emptyMessage}</Text>
        ) : (
          <SectionList
            accessibilityRole="list"
            sections={sections}
            keyExtractor={(item: Session) => String(item.id)}
            stickySectionHeadersEnabled={false}
            renderItem={({ item }: { item: Session }) => <Row session={item} palette={palette} onRowOpen={onRowOpen} onRowClose={onRowClose} />}
            renderSectionHeader={({ section }: { section: { key: string; title: string; data: Session[] } }) => (
              <Text style={[styles.sectionHeader, { color: palette.accent }]}>{section.title}</Text>
            )}
            contentContainerStyle={styles.list}
          />
        )
      ) : null}
    </View>
  );
}

const styles = StyleSheet.create({
  screen: {
    flex: 1,
    padding: 16,
    gap: 12,
  },
