466|void ObjectManager::ReleaseAllRegistered() {
467|  HandleScope handleScope(m_isolate);
468|
469|  auto jsInfoIdx = static_cast<int>(MetadataNodeKeys::JsInfo);
470|
471|  // Detached first: nothing below should observe a half-emptied map, and the
472|  // finalizers these handles were armed with will never run now anyway.
473|  auto survivors = std::move(m_idToObject);
474|  m_idToObject.clear();
475|
476|  for (auto& entry : survivors) {
477|    ObjectWeakCallbackState* state = entry.second;
478|    Persistent<Object>* po = state->target;
479|
480|    if (!po->IsEmpty()) {
481|      auto local = po->Get(m_isolate);
482|      if (!local.IsEmpty()) {
483|        // Drop the back-pointer before the JSInstanceInfo goes away.
484|        local->SetInternalField(jsInfoIdx, Undefined(m_isolate));
485|      }
486|      po->Reset();
487|    }
488|
489|    delete po;
503|  // cache holds a JNI weak global ref per entry (up to its capacity) and only
504|  // ever evicted them under capacity pressure, so a worker that touched Java
505|  // objects abandoned the whole cache when it died. ART's weak-global table is
506|  // bounded, so enough worker cycles turned that leak into an abort.
507|  m_cache.clear();
