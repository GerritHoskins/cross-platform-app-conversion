397|/*
398| * When JS GC happens change state of the java counterpart to mirror state of JS
399| * object and REVIVE the JS object unconditionally "Regular" js objects are
400| * pushed into the "regular objects" array "Callback" js objects (ones that have
401| * implementation object) are pushed into two "special objects" array: -ones
402| * called for the first time which are originally strong in java -ones called
403| * for the second or next time which are already weak in java too These objects
404| * are categorized by "regular" and "callback" and saved in different arrays for
405| * performance optimizations during GC
406| * */
407|void ObjectManager::JSObjectWeakCallback(
408|    Isolate* isolate, ObjectWeakCallbackState* callbackState) {
409|  HandleScope handleScope(isolate);
410|
411|  Persistent<Object>* po = callbackState->target;
412|
413|  auto itFound = m_visitedPOs.find(po);
414|
415|  if (itFound == m_visitedPOs.end()) {
416|    m_visitedPOs.insert(po);
417|
418|    auto obj = Local<Object>::New(isolate, *po);
419|    JSInstanceInfo* jsInstanceInfo = GetJSInstanceInfo(obj);
420|
421|    if (jsInstanceInfo != nullptr) {
422|      int javaObjectID = jsInstanceInfo->JavaObjectID;
423|
424|      bool hasImplObj = HasImplObject(isolate, obj);
425|
426|      DEBUG_WRITE("JSObjectWeakCallback objectId: %d, hasImplObj=%d",
427|                  javaObjectID, hasImplObj);
428|
429|      if (hasImplObj) {
430|        if (jsInstanceInfo->IsJavaObjectWeak) {
431|          m_implObjWeak.emplace_back(po, javaObjectID);
432|        } else {
433|          m_implObjStrong.emplace(javaObjectID, po);
434|          jsInstanceInfo->IsJavaObjectWeak = true;
435|        }
436|      } else {
437|        if (m_markedForGC.empty()) {
438|          // Emulates the behavior in the OnGcStarted callback. Тhis is
439|          // necessary as the hooking to the V8 GC is done only on the
440|          // markSweepCompact phase. The JSObjectWeakCallback however is still
441|          // triggered in other V8 GC phases (scavenger for example). This
442|          // creates a problem that there is no 'top' on the m_markedForGC
443|          // stack.
444|          GarbageCollectionInfo gcInfo(++m_numberOfGC);
445|          gcInfo.markedForGC.push_back(po);
446|          m_markedForGC.push(gcInfo);
447|        } else {
448|          auto& topGCInfo = m_markedForGC.top();
449|          topGCInfo.markedForGC.push_back(po);
450|        }
451|      }
452|    }
453|  }
454|
455|  po->SetWeak(callbackState, JSObjectWeakCallbackStatic,
456|              WeakCallbackType::kFinalizer);
457|}
