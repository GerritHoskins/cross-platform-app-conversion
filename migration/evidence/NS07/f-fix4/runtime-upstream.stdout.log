510|void ObjectManager::ReleaseJSInstance(Persistent<Object>* po,
511|                                      JSInstanceInfo* jsInstanceInfo) {
512|  int javaObjectID = jsInstanceInfo->JavaObjectID;
513|
514|  auto it = m_idToObject.find(javaObjectID);
515|
516|  if (it == m_idToObject.end()) {
517|    stringstream ss;
518|    ss << "(InternalError): Js object with id: " << javaObjectID
519|       << " not found";
520|    throw NativeScriptException(ss.str());
521|  }
522|
523|  NS_DCHECK(po == it->second->target);
524|
525|  ObjectWeakCallbackState* callbackState = it->second;
526|  m_idToObject.erase(it);
527|  delete callbackState;
528|  m_released.insert(po, javaObjectID);
529|  po->Reset();
530|
531|  delete po;
532|  delete jsInstanceInfo;
533|
534|  DEBUG_WRITE("ReleaseJSObject instance disposed. id:%d", javaObjectID);
535|}
