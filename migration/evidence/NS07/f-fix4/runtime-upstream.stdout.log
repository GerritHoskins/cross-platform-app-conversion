537|/*
538| * The "regular" JS objects added on ObjectManager::JSObjectWeakCallback are
539| * dealt with(released) here.
540| * */
541|void ObjectManager::ReleaseRegularObjects() {
542|  TNSPERF();
543|
544|  HandleScope handleScope(m_isolate);
545|
546|  auto propName =
547|      String::NewFromUtf8(m_isolate, "t::gcNum", NewStringType::kNormal)
548|          .ToLocalChecked();
549|
550|  auto& topGCInfo = m_markedForGC.top();
551|  auto& marked = topGCInfo.markedForGC;
552|  int numberOfGC = topGCInfo.numberOfGC;
553|
554|  for (auto po : marked) {
555|    if (m_released.contains(po)) {
556|      continue;
557|    }
558|
559|    auto obj = Local<Object>::New(m_isolate, *po);
560|
561|    NS_DCHECK(!obj.IsEmpty());
562|
563|    Local<Value> gcNum;
564|    V8GetPrivateValue(m_isolate, obj, propName, gcNum);
565|
566|    bool isReachableFromImplementationObject = false;
567|
568|    if (!gcNum.IsEmpty() && gcNum->IsNumber()) {
569|      double objGcNum = gcNum.As<Number>()->Value();
570|
571|      // done so we can release only java objects from this GC stack and pass
572|      // all objects that will be released in parent GC stacks
573|      isReachableFromImplementationObject = objGcNum >= numberOfGC;
574|    }
575|
576|    JSInstanceInfo* jsInstanceInfo = GetJSInstanceInfo(obj);
577|
578|    if (!isReachableFromImplementationObject) {
579|      if (!jsInstanceInfo->IsJavaObjectWeak) {
580|        jsInstanceInfo->IsJavaObjectWeak = true;
581|
582|        ReleaseJSInstance(po, jsInstanceInfo);
583|      }
584|    }
585|  }
586|
587|  marked.clear();
