360|void ObjectManager::JSObjectFinalizer(Isolate* isolate,
361|                                      ObjectWeakCallbackState* callbackState) {
362|  HandleScope handleScope(m_isolate);
363|  Persistent<Object>* po = callbackState->target;
364|  auto jsInstanceInfo = GetJSInstanceInfoFromRuntimeObject(po->Get(m_isolate));
365|
366|  if (jsInstanceInfo == nullptr) {
367|    // The link was already torn down (ReleaseNativeCounterpart); nothing but
368|    // the registration is left to drop.
369|    m_idToObject.erase(callbackState->javaObjectID);
370|    po->Reset();
371|    delete po;
372|    delete callbackState;
373|    return;
374|  }
375|
376|  auto javaObjectID = jsInstanceInfo->JavaObjectID;
377|  JEnv env;
378|  jboolean isJavaInstanceAlive = env.CallBooleanMethod(
379|      m_javaRuntimeObject, MAKE_INSTANCE_WEAK_AND_CHECK_IF_ALIVE_METHOD_ID,
380|      javaObjectID);
381|  if (isJavaInstanceAlive) {
382|    // If the Java instance is alive, keep the JavaScript instance alive.
383|    po->SetWeak(callbackState, JSObjectFinalizerStatic,
384|                WeakCallbackType::kFinalizer);
385|  } else {
386|    // If the Java instance is dead, this JavaScript instance can be let die.
387|    delete jsInstanceInfo;
388|    auto jsInfoIdx = static_cast<int>(MetadataNodeKeys::JsInfo);
389|    po->Get(m_isolate)->SetInternalField(jsInfoIdx, Undefined(m_isolate));
390|    po->Reset();
391|    m_idToObject.erase(javaObjectID);
392|    delete po;
393|    delete callbackState;
394|  }
